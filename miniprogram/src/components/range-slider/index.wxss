:host { display: block; width: 100%; }
.range-control { height: 120rpx; position: relative; padding: 0 44rpx; }
.range-rail { position: absolute; left: 44rpx; right: 44rpx; top: 45rpx; height: 14rpx; border-radius: 7rpx; background: #e8edf3; }
.range-fill { position: absolute; top: 0; height: 100%; border-radius: 7rpx; background: #2869e8; pointer-events: none; }
.range-handle { position: absolute; top: -43rpx; width: 88rpx; height: 114rpx; margin-left: -44rpx; display: flex; align-items: center; flex-direction: column; justify-content: center; z-index: 2; }
.range-grip { position: relative; width: 34rpx; height: 52rpx; border: 3rpx solid #2869e8; border-radius: 10rpx; background: #fff; box-shadow: 0 4rpx 12rpx rgba(40, 105, 232, 0.12); }
.range-grip::before, .range-grip::after { content: ''; position: absolute; top: 13rpx; width: 3rpx; height: 20rpx; border-radius: 2rpx; background: #2869e8; }
.range-grip::before { left: 9rpx; } .range-grip::after { right: 9rpx; }
.range-handle-label { margin-top: 9rpx; font-size: 19rpx; line-height: 1.2; color: #6b7688; }
.range-handle.is-active { z-index: 3; }
.range-handle.is-active .range-grip { background: #edf4ff; box-shadow: 0 0 0 8rpx rgba(40, 105, 232, 0.1); }
.is-disabled { opacity: 0.5; }
